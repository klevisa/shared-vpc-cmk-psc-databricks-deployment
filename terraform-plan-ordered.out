# Shared-VPC template — plan blocks in CREATION-DEPENDENCY order
# HOST project = example-shared-vpc-host, SERVICE project = example-databricks-svc.
# Terraform's own plan output is alphabetical; this file re-orders it by dependency.
# NOTE: the automation SA's own host-project network roles are a PREREQUISITE
#       (granted by the host-project owner before apply), not managed here.


# ==========================================================================
# LAYER 0 — naming
# ==========================================================================
  # random_string.suffix will be created
  + resource "random_string" "suffix" {
      + id          = (known after apply)
      + length      = 3
      + lower       = true
      + min_lower   = 0
      + min_numeric = 0
      + min_special = 0
      + min_upper   = 0
      + number      = true
      + numeric     = true
      + result      = (known after apply)
      + special     = false
      + upper       = false
    }

Plan: 34 to add, 0 to change, 0 to destroy.

Changes to Outputs:
  + backend_pe_ip        = (known after apply)
  + backend_psc_status   = (known after apply)
  + front_end_psc_status = (known after apply)
  + frontend_pe_ip       = (known after apply)
  + host_project         = "example-shared-vpc-host"
  + metastore_assignment = "none (relying on auto-assignment)"
  + service_project      = "example-databricks-svc"
  + workspace_id         = (known after apply)
  + workspace_url        = (known after apply)

# ==========================================================================
# LAYER 1 — Shared VPC association (org-level; needs xpnAdmin)
# ==========================================================================
  # google_compute_shared_vpc_host_project.host[0] will be created
  + resource "google_compute_shared_vpc_host_project" "host" {
      + deletion_policy = "DELETE"
      + id              = (known after apply)
      + project         = "example-shared-vpc-host"
    }
  # google_compute_shared_vpc_service_project.service[0] will be created
  + resource "google_compute_shared_vpc_service_project" "service" {
      + host_project    = "example-shared-vpc-host"
      + id              = (known after apply)
      + service_project = "example-databricks-svc"
    }

# ==========================================================================
