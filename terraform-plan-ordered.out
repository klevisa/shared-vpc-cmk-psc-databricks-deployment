      + udp_idle_timeout_sec                = 30
    }

# ==========================================================================
# LAYER 4 — HOST firewall
# ==========================================================================
  # google_compute_firewall.allow_internal will be created
  + resource "google_compute_firewall" "allow_internal" {
      + creation_timestamp = (known after apply)
      + deletion_policy    = "DELETE"
      + destination_ranges = (known after apply)
      + direction          = "INGRESS"
      + enable_logging     = (known after apply)
      + id                 = (known after apply)
      + name               = "example-vpc-allow-internal"
      + network            = (known after apply)
      + priority           = 1000
      + project            = "example-shared-vpc-host"
      + self_link          = (known after apply)
      + source_ranges      = [
          + "10.10.0.0/24",
          + "10.10.1.0/28",
        ]

      + allow {
          + ports    = []
          + protocol = "icmp"
        }
      + allow {
          + ports    = []
          + protocol = "tcp"
        }
      + allow {
          + ports    = []
          + protocol = "udp"
        }
    }
  # google_compute_firewall.node_to_psc will be created
  + resource "google_compute_firewall" "node_to_psc" {
      + creation_timestamp = (known after apply)
      + deletion_policy    = "DELETE"
      + destination_ranges = [
          + "10.10.1.0/28",
        ]
      + direction          = "INGRESS"
      + enable_logging     = (known after apply)
      + id                 = (known after apply)
      + name               = "example-vpc-node-to-psc"
      + network            = (known after apply)
      + priority           = 1000
      + project            = "example-shared-vpc-host"
      + self_link          = (known after apply)
      + source_ranges      = [
          + "10.10.0.0/24",
        ]

      + allow {
          + ports    = [
              + "443",
              + "6666",
              + "8443-8451",
            ]
          + protocol = "tcp"
        }
    }

